# Copia este archivo como .env y ajusta los valores para tu entorno.
# Nunca subas .env al repositorio.

SECRET_KEY=django-insecure-change-me-for-local-dev-only
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Opcional: base de datos externa (PostgreSQL, etc.)
# DATABASE_URL=postgres://usuario:password@host:5432/nombre_bd
# DB_SSL_REQUIRE=False

# Recomendado en producción (cuando DEBUG=False)
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=3600
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
# SECURE_REFERRER_POLICY=same-origin
# LOG_LEVEL=INFO

